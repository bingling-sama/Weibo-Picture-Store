{
  "name": "weibo-picture-store-plasmo",
  "private": true,
  "version": "0.1.0",
  "description": "Fresh Plasmo rewrite of Weibo Picture Store",
  "packageManager": "pnpm@8.10.5",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "manifest": {
    "manifest_version": 3,
    "name": "__MSG_ext_name__",
    "default_locale": "zh_CN",
    "description": "__MSG_ext_desc__",
    "minimum_chrome_version": "110",
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Alt+Shift+W"
        }
      },
      "execute_pointer_events": {
        "suggested_key": {
          "default": "Alt+Shift+T"
        },
        "description": "置顶页面中的视频和图片"
      }
    },
    "permissions": [
      "clipboardWrite",
      "contextMenus",
      "declarativeNetRequestWithHostAccess",
      "downloads",
      "notifications",
      "scripting",
      "tabs",
      "storage",
      "windows"
    ],
    "host_permissions": [
      "*://*.weibo.cn/*",
      "*://*.weibo.com/*",
      "*://*.sina.com.cn/*",
      "*://*.sinaimg.cn/*"
    ],
    "optional_host_permissions": [
      "*://*/*"
    ],
    "homepage_url": "https://github.com/Semibold/Weibo-Picture-Store",
    "browser_specific_settings": {
      "gecko": {
        "id": "weibo-picture-store@ext.hub.moe",
        "strict_min_version": "115.0"
      }
    }
  },
  "dependencies": {
    "plasmo": "latest",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.2"
  }
}
